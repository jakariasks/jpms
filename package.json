{
  "name": "jakaria-personal-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "format": "prettier --write src tests scripts docs README.md *.json *.js",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "5.102.8",
    "lucide-react": "1.42.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-router-dom": "7.18.3",
    "recharts": "3.10.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2"
  }
}
